generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  nik            String    @unique
  nama           String
  email          String    @unique
  password_hash  String
  role           String    @default("Karyawan") // Karyawan, Lead, Manager, HR, Admin
  avatar         String?
  divisi_id      Int?
  manager_id     Int?
  
  // Relations
  manager        User?     @relation("UserManager", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates   User[]    @relation("UserManager")
  
  attendanceLogs AttendanceLog[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AttendanceLog {
  id              Int       @id @default(autoincrement())
  user_id         Int
  tanggal         DateTime  // Tanggal shift
  jam_masuk       DateTime?
  jam_pulang      DateTime?
  tipe_lokasi     String    // WFO, WFH, Dinas
  koordinat_masuk String?
  koordinat_pulang String?
  foto_bukti_masuk String?
  foto_bukti_pulang String?
  status_kehadiran String   // Tepat Waktu, Terlambat, Absen
  is_valid        Boolean   @default(true)
  catatan         String?
  
  user            User      @relation(fields: [user_id], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LeaveBalance {
  id              Int       @id @default(autoincrement())
  user_id         Int
  tahun           Int
  tipe_cuti       String    // Tahunan, Sakit, Lembur
  kuota_total     Int
  kuota_terpakai  Int       @default(0)
  
  user            User      @relation(fields: [user_id], references: [id])
  
  @@unique([user_id, tahun, tipe_cuti])
}

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  user_id         Int
  tipe_pengajuan  String    // Cuti Tahunan, Sakit, Lembur
  tgl_mulai       DateTime
  tgl_selesai     DateTime
  alasan          String
  dokumen_url     String?
  status          String    @default("PENDING_LEAD") // DRAFT, PENDING_LEAD, PENDING_HR, APPROVED, REJECTED
  
  user            User      @relation(fields: [user_id], references: [id])
  approvalLogs    ApprovalLog[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ApprovalLog {
  id                Int       @id @default(autoincrement())
  leave_request_id  Int
  approver_id       Int
  status_keputusan  String    // APPROVED, REJECTED
  catatan           String?
  
  leaveRequest      LeaveRequest @relation(fields: [leave_request_id], references: [id])
  
  createdAt         DateTime  @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}
